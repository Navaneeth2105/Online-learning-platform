# ─── PayPal (Frontend) ───────────────────────────────────────────────────────
# Your PayPal App Client ID from https://developer.paypal.com/dashboard/
# Leave blank to use the sample/mock payment button in development
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Currency for PayPal transactions (must match server PAYPAL_CURRENCY)
VITE_PAYPAL_CURRENCY=INR

# ─── API Port (optional override) ────────────────────────────────────────────
# PORT=5000
# VITE_PORT=3000
