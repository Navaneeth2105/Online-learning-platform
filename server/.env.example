# ─── Server Configuration ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Leave blank to auto-use in-memory MongoDB (zero-config dev mode)
MONGODB_URI=

# ─── JWT Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ─── PayPal Payment Integration ──────────────────────────────────────────────
# Get credentials from https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
# sandbox | live
PAYPAL_MODE=sandbox
# INR | USD | EUR etc.
PAYPAL_CURRENCY=INR

# ─── Dev / Testing ───────────────────────────────────────────────────────────
# Set to true to enable the /api/enrollments/sample-payment route (dev only)
ALLOW_SAMPLE_PAYMENTS=true

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (optional)
# CORS_ORIGIN=http://localhost:3000,https://your-deployed-app.vercel.app
